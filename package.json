{
  "name": "auto-approve-action",
  "version": "5.0.0",
  "description": "Automatically approve pull requests",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "ncc build src/index.ts",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mindrunner/auto-approve-action.git"
  },
  "keywords": [
    "actions"
  ],
  "author": "hmarr",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mindrunner/auto-approve-action/issues"
  },
  "homepage": "https://github.com/mindrunner/auto-approve-action#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@octokit/request-error": "7.1.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "jest": "30.4.2",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3"
  },
  "prettier": {}
}
